{
    "$schema": "https://unpkg.com/knip/schema.json",
    "ignoreBinaries": [
        "ffmpeg",
        "dbus-run-session"
    ],
    "entry": [
        "tests/*.test.ts",
        "tests/appimage-smoke.cjs",
        "tests/electron-smoke.cjs",
        "tests/library-ui.cjs",
        "tests/downloader-ui.cjs",
        "tests/dev-startup.cjs"
    ],
    "project": [
        "src/**/*.{ts,tsx,css}",
        "tests/**/*.{ts,cjs}",
        "*.config.ts"
    ],
    "ignoreIssues": {
        "src/renderer/src/components/ui/**": [
            "exports",
            "types"
        ]
    }
}

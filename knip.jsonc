{
    "$schema": "https://unpkg.com/knip/schema.json",
    "entry": [
        "tests/*.test.ts",
        "tests/electron-smoke.cjs"
    ],
    "project": [
        "src/**/*.{ts,tsx,css}",
        "tests/**/*.{ts,cjs}",
        "*.config.ts"
    ],
    "ignoreIssues": {
        "src/renderer/src/components/ui/**": [
            "exports",
            "types"
        ]
    }
}

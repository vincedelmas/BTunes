{
    "name": "btunes",
    "version": "1.1.0",
    "private": true,
    "description": "Local music library manager and player.",
    "main": "out/main/index.js",
    "packageManager": "bun@1.4.4",
    "scripts": {
        "knip": "knip",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint --max-warnings=0",
        "db:generate": "drizzle-kit generate",
        "lint:fix": "oxlint --fix --max-warnings=0",
        "test:appimage": "node tests/appimage-smoke.cjs",
        "build": "bun run typecheck && electron-vite build",
        "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
        "package": "bun run build && electron-builder --linux dir",
        "test": "node --experimental-strip-types --test tests/*.test.ts",
        "package:appimage": "bun run build && bun run package:appimage:built",
        "package:appimage:built": "electron-builder --linux AppImage --x64 --publish never",
        "test:electron": "bun run build && env -u ELECTRON_RUN_AS_NODE electron --ozone-platform=headless tests/electron-smoke.cjs && env -u ELECTRON_RUN_AS_NODE electron --ozone-platform=headless tests/library-ui.cjs && env -u ELECTRON_RUN_AS_NODE electron --ozone-platform=headless tests/downloader-ui.cjs && env -u ELECTRON_RUN_AS_NODE electron --ozone-platform=headless tests/dev-startup.cjs"
    },
    "dependencies": {
        "chokidar": "6.0.0",
        "dbus-next": "^0.10.2",
        "drizzle-orm": "1.0.0-rc.5",
        "electron-updater": "^6.8.11",
        "music-metadata": "12.3.5",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@babel/core": "^8.1.0",
        "@base-ui/react": "^1.9.0",
        "@fontsource-variable/inter": "^5.3.0",
        "@rolldown/plugin-babel": "^0.3.0",
        "@tailwindcss/vite": "4.3.4",
        "@tanstack/react-table": "^9.3.1",
        "@tanstack/react-virtual": "^3.14.26",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.2.1",
        "babel-plugin-react-compiler": "^1.0.0",
        "class-variance-authority": "0.7.1",
        "cn": "^0.5.2",
        "drizzle-kit": "1.0.0-rc.5",
        "electron": "45.2.3",
        "electron-builder": "26.18.0",
        "electron-vite": "6.0.0",
        "knip": "^6.44.1",
        "lucide-react": "1.70.0",
        "oxlint": "^1.92.0",
        "oxlint-tsgolint": "^7.0.2006",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "shadcn": "^4.23.0",
        "tailwindcss": "4.3.4",
        "tw-animate-css": "^1.4.0",
        "typescript": "7.0.2",
        "vite": "8.3.6"
    },
    "trustedDependencies": [
        "electron",
        "esbuild"
    ],
    "build": {
        "appId": "dev.btunes.music",
        "productName": "BTunes",
        "files": [
            "out/**/*",
            "package.json"
        ],
        "linux": {
            "category": "AudioVideo",
            "target": [
                "AppImage"
            ],
            "icon": "resources/icon.png",
            "desktop": {
                "entry": {
                    "StartupWMClass": "btunes"
                }
            },
            "executableName": "btunes"
        },
        "extraResources": [
            {
                "from": "drizzle",
                "to": "drizzle",
                "filter": [
                    "**/migration.sql"
                ]
            },
            {
                "from": "resources/icon.png",
                "to": "icon.png"
            }
        ],
        "artifactName": "BTunes-${version}-${arch}.${ext}",
        "publish": {
            "provider": "github",
            "owner": "vincedelmas",
            "repo": "BTunes"
        }
    },
    "desktopName": "btunes.desktop",
    "homepage": "https://github.com/vincedelmas/BTunes",
    "repository": {
        "type": "git",
        "url": "https://github.com/vincedelmas/BTunes.git"
    },
    "author": {
        "name": "Vince Delmas",
        "url": "https://github.com/vincedelmas"
    }
}

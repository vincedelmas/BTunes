{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": [
        "typescript",
        "react",
        "unicorn",
        "oxc"
    ],
    "options": {
        "typeAware": true
    },
    "rules": {
        "typescript/no-deprecated": "error"
    },
    "ignorePatterns": [
        "out/**",
        "dist/**",
        "node_modules/**"
    ]
}
